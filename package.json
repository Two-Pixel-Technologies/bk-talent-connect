{
  "name": "bk-talent-connect",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BK Talent Connect \u2014 managed recruitment portal",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@bktc/api & npm run dev --workspace=@bktc/web",
    "build": "npm run build --workspace=@bktc/shared && npm run build --workspace=@bktc/api && npm run build --workspace=@bktc/web",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test --workspace=@bktc/api",
    "db:migrate": "npm run db:migrate --workspace=@bktc/api",
    "db:seed": "npm run db:seed --workspace=@bktc/api",
    "seed:demo": "npm run seed:demo --workspace=@bktc/api",
    "admin:create": "npm run admin:create --workspace=@bktc/api",
    "admin:reset-password": "npm run admin:reset-password --workspace=@bktc/api",
    "maintenance": "npm run maintenance --workspace=@bktc/api",
    "start:prod": "npm run build && node scripts/start-prod.js",
    "start:nginx": "bash scripts/nginx-local.sh",
    "start": "bash scripts/nginx-dev.sh",
    "deadcode": "knip --no-config-hints",
    "verify": "npm run lint && npm run typecheck && npm run deadcode && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "knip": "^6.32.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
