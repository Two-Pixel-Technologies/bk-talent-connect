# Copy to .env for local development. Never commit the real file.
# On the droplet this lives in shared/.env (chmod 600), outside every release dir.

NODE_ENV=development
PORT=4000

# SQLite file plus its -wal/-shm sidecars.
DATABASE_PATH=./data/bktc.db

# Resume storage. Must be outside the web root — files are served only through
# an authorised API route, never by nginx directly.
UPLOADS_DIR=./uploads

# Multer's landing area. Same filesystem as UPLOADS_DIR so the rename into place
# is atomic.
TMP_DIR=./tmp

# Origin permitted to make state-changing requests. Same-origin in production.
APP_ORIGIN=http://localhost:5173

# Set by the deploy script to the git sha. The SPA compares it against its own
# build-time version to detect a stale bundle after a deploy.
APP_VERSION=dev

LOG_LEVEL=info

# Proxy hops to trust. Exactly 1 behind nginx; 0 when running directly.
# Getting this wrong breaks rate limiting in one of two ways: too low and every
# request looks like 127.0.0.1 so five failed logins lock out everyone, too high
# and X-Forwarded-For becomes attacker-controlled.
TRUST_PROXY_HOPS=0

# Read only by `npm run admin:create`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Email/WhatsApp delivery (see apps/api/src/lib/channels.ts). Both default to
# false, which routes every send through a logging-only transport — safe to
# run with no provider configured. Flipping either to true without first
# wiring a real transport in channels.ts still never breaks the app; it just
# logs a warning and keeps using the logging transport. No SES/Meta
# credentials are read anywhere yet — see channels.ts's header comment for
# what wiring a real provider requires.
EMAIL_DELIVERY_ENABLED=false
WHATSAPP_DELIVERY_ENABLED=false

# How often the 24-hour-before interview reminder sweep runs, in ms.
INTERVIEW_REMINDER_SWEEP_MS=900000
